<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.boris.jarvis-calls-sync</string>

  <!-- Ingestion des calls Sembly → Atlas, toutes les 30 minutes. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/borisarduy/ops-cockpit/ops-cockpit &amp;&amp; npx tsx scripts/calls-sync.ts >> "$HOME/Library/Logs/jarvis-calls-sync.log" 2>&amp;1</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
