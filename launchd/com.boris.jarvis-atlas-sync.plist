<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.boris.jarvis-atlas-sync</string>

  <!-- Sync quotidienne Cockpit → Atlas à 07:15, avant le brief du matin. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/borisarduy/ops-cockpit/ops-cockpit &amp;&amp; npx tsx scripts/atlas-sync.ts >> "$HOME/Library/Logs/jarvis-atlas-sync.log" 2>&amp;1</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
